<?xml version='1.0' encoding='utf-8'?>
<document type="com.apple.InterfaceBuilder3.Cocoa.Storyboard.XIB" version="3.0" toolsVersion="17150" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" initialViewController="WindowController">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="17150" />
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0" />
    </dependencies>
    <scenes>
        <scene sceneID="WindowScene">
            <objects>
                <windowController id="WindowController" sceneMemberID="viewController">
                    <window key="window" title="MXLogger Demo · macOS" releasedWhenClosed="NO" id="DemoWindow">
                        <windowStyleMask key="styleMask" titled="YES" closable="YES" miniaturizable="YES" resizable="YES" />
                        <rect key="contentRect" x="180" y="100" width="1000" height="820" />
                    </window>
                    <connections>
                        <segue destination="Root" kind="relationship" relationship="window.shadowedContentViewController" id="c-0001" />
                    </connections>
                </windowController>
            </objects>
        </scene>
        <scene sceneID="RootScene">
            <objects>
                <viewController id="Root" storyboardIdentifier="Root" sceneMemberID="viewController" customClass="DemoViewController" customModule="MXLoggerDemo" customModuleProvider="target">
                    <view id="RootView" key="view" customClass="DemoBackgroundView" customModule="MXLoggerDemo" customModuleProvider="target">
                        <rect key="frame" x="0" y="0" width="1000" height="820" />
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
                        <subviews>
                            <textField id="NavTitle" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO">
                                <rect key="frame" x="250" y="776" width="500" height="24" />
                                <textFieldCell key="cell" title="MXLogger Demo" id="c-0002" alignment="center" wraps="YES" scrollable="NO" lineBreakMode="truncatingTail">
                                    <font key="font" metaFont="systemBold" size="17" />
                                    <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog" />
                                </textFieldCell>
                            </textField>
                            <button id="Back" translatesAutoresizingMaskIntoConstraints="NO">
                                <rect key="frame" x="18" y="771" width="95" height="32" />
                                <buttonCell key="cell" type="push" title="‹ Back" bezelStyle="rounded" alignment="center" borderStyle="border" inset="2" id="c-0003">
                                    <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES" />
                                    <font key="font" metaFont="system" size="13" />
                                </buttonCell>
                                <connections>
                                    <action selector="back:" target="Root" id="c-0004" />
                                </connections>
                            </button>
                            <button id="Language" translatesAutoresizingMaskIntoConstraints="NO">
                                <rect key="frame" x="885" y="771" width="95" height="32" />
                                <buttonCell key="cell" type="push" title="中文" bezelStyle="rounded" alignment="center" borderStyle="border" inset="2" id="c-0005">
                                    <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES" />
                                    <font key="font" metaFont="system" size="13" />
                                </buttonCell>
                                <connections>
                                    <action selector="toggleLanguage:" target="Root" id="c-0006" />
                                </connections>
                            </button>
                            <view id="PageContainer" translatesAutoresizingMaskIntoConstraints="NO">
                                <rect key="frame" x="0" y="34" width="1000" height="730" />
                            </view>
                            <textField id="Status" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO">
                                <rect key="frame" x="24" y="8" width="950" height="18" />
                                <textFieldCell key="cell" title="" id="c-0007" alignment="left" wraps="YES" scrollable="NO" lineBreakMode="truncatingTail">
                                    <font key="font" metaFont="system" size="11" />
                                    <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog" />
                                </textFieldCell>
                            </textField>
                        </subviews>
                        <constraints>
                            <constraint firstItem="NavTitle" firstAttribute="centerX" id="c-0008" secondItem="RootView" secondAttribute="centerX" />
                            <constraint firstItem="NavTitle" firstAttribute="top" id="c-0009" secondItem="RootView" secondAttribute="top" constant="17" />
                            <constraint firstItem="NavTitle" firstAttribute="width" id="c-0010" constant="620" />
                            <constraint firstItem="Back" firstAttribute="leading" id="c-0011" secondItem="RootView" secondAttribute="leading" constant="18" />
                            <constraint firstItem="Back" firstAttribute="top" id="c-0012" secondItem="RootView" secondAttribute="top" constant="11" />
                            <constraint firstItem="Language" firstAttribute="trailing" id="c-0013" secondItem="RootView" secondAttribute="trailing" constant="-18" />
                            <constraint firstItem="Language" firstAttribute="top" id="c-0014" secondItem="RootView" secondAttribute="top" constant="11" />
                            <constraint firstItem="PageContainer" firstAttribute="leading" id="c-0015" secondItem="RootView" secondAttribute="leading" />
                            <constraint firstItem="RootView" firstAttribute="trailing" id="c-0016" secondItem="PageContainer" secondAttribute="trailing" />
                            <constraint firstItem="PageContainer" firstAttribute="top" id="c-0017" secondItem="RootView" secondAttribute="top" constant="56" />
                            <constraint firstItem="RootView" firstAttribute="bottom" id="c-0018" secondItem="PageContainer" secondAttribute="bottom" constant="34" />
                            <constraint firstItem="Status" firstAttribute="leading" id="c-0019" secondItem="RootView" secondAttribute="leading" constant="24" />
                            <constraint firstItem="RootView" firstAttribute="trailing" id="c-0020" secondItem="Status" secondAttribute="trailing" constant="24" />
                            <constraint firstItem="RootView" firstAttribute="bottom" id="c-0021" secondItem="Status" secondAttribute="bottom" constant="8" />
                        </constraints>
                    </view>
                    <connections>
                        <outlet property="content" destination="PageContainer" id="c-0022" />
                        <outlet property="titleLabel" destination="NavTitle" id="c-0023" />
                        <outlet property="backButton" destination="Back" id="c-0024" />
                        <outlet property="languageButton" destination="Language" id="c-0025" />
                        <outlet property="statusLabel" destination="Status" id="c-0026" />
                    </connections>
                </viewController>
                <customObject id="RootResponder" userLabel="First Responder" customClass="NSResponder" sceneMemberID="firstResponder" />
            </objects>
        </scene>
        <scene sceneID="LandingScene">
            <objects>
                <viewController id="Landing" storyboardIdentifier="Landing" sceneMemberID="viewController" customClass="DemoLandingViewController" customModule="MXLoggerDemo" customModuleProvider="target">
                    <view id="LandingView" key="view" customClass="DemoBackgroundView" customModule="MXLoggerDemo" customModuleProvider="target">
                        <rect key="frame" x="0" y="0" width="1000" height="730" />
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
                        <subviews>
                            <imageView id="LandingLogo" translatesAutoresizingMaskIntoConstraints="NO">
                                <rect key="frame" x="452" y="410" width="96" height="96" />
                                <imageCell key="cell" refusesFirstResponder="YES" alignment="center" imageScaling="proportionallyUpOrDown" id="c-0027" image="mxlogger_logo" />
