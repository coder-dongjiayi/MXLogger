                                </textFieldCell>
                            </textField>
                            <button id="Enter" translatesAutoresizingMaskIntoConstraints="NO" customClass="DemoPrimaryButton" customModule="MXLoggerDemo" customModuleProvider="target">
                                <rect key="frame" x="380" y="110" width="240" height="48" />
                                <buttonCell key="cell" type="push" title="Enter Demo" bezelStyle="rounded" alignment="center" borderStyle="border" inset="2" id="c-0030">
                                    <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES" />
                                    <font key="font" metaFont="system" size="13" />
                                </buttonCell>
                                <connections>
                                    <action selector="enter:" target="Landing" id="c-0031" />
                                </connections>
                            </button>
                            <textField id="Version" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO">
                                <rect key="frame" x="260" y="65" width="480" height="22" />
                                <textFieldCell key="cell" title="macOS Native Demo · MXLogger 2.2.0" id="c-0032" alignment="center" wraps="YES" scrollable="NO" lineBreakMode="truncatingTail">
                                    <font key="font" metaFont="system" size="12" />
                                    <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog" />
                                </textFieldCell>
                            </textField>
                        </subviews>
                        <constraints>
                            <constraint firstItem="LandingLogo" firstAttribute="centerX" id="c-0033" secondItem="LandingView" secondAttribute="centerX" />
                            <constraint firstItem="Brand" firstAttribute="centerX" id="c-0034" secondItem="LandingView" secondAttribute="centerX" />
                            <constraint firstItem="LandingSubtitle" firstAttribute="centerX" id="c-0035" secondItem="LandingView" secondAttribute="centerX" />
                            <constraint firstItem="Enter" firstAttribute="centerX" id="c-0036" secondItem="LandingView" secondAttribute="centerX" />
                            <constraint firstItem="Version" firstAttribute="centerX" id="c-0037" secondItem="LandingView" secondAttribute="centerX" />
                            <constraint firstItem="LandingLogo" firstAttribute="width" id="c-0038" constant="96" />
                            <constraint firstItem="LandingLogo" firstAttribute="height" id="c-0039" constant="96" />
                            <constraint firstItem="LandingLogo" firstAttribute="centerY" id="c-0040" secondItem="LandingView" secondAttribute="centerY" constant="-70" />
                            <constraint firstItem="Brand" firstAttribute="top" id="c-0041" secondItem="LandingLogo" secondAttribute="bottom" constant="24" />
                            <constraint firstItem="Brand" firstAttribute="width" id="c-0042" constant="440" />
                            <constraint firstItem="Brand" firstAttribute="height" id="c-0043" constant="42" />
                            <constraint firstItem="LandingSubtitle" firstAttribute="top" id="c-0044" secondItem="Brand" secondAttribute="bottom" constant="10" />
                            <constraint firstItem="LandingSubtitle" firstAttribute="width" id="c-0045" constant="720" />
                            <constraint firstItem="LandingSubtitle" firstAttribute="height" id="c-0046" constant="52" />
                            <constraint firstItem="Enter" firstAttribute="width" id="c-0047" constant="240" />
                            <constraint firstItem="Enter" firstAttribute="height" id="c-0048" constant="48" />
                            <constraint firstItem="LandingView" firstAttribute="bottom" id="c-0049" secondItem="Enter" secondAttribute="bottom" constant="110" />
                            <constraint firstItem="Version" firstAttribute="top" id="c-0050" secondItem="Enter" secondAttribute="bottom" constant="14" />
                            <constraint firstItem="Version" firstAttribute="width" id="c-0051" constant="500" />
                        </constraints>
                    </view>
                    <connections>
                        <outlet property="subtitle" destination="LandingSubtitle" id="c-0052" />
                        <outlet property="enterButton" destination="Enter" id="c-0053" />
                        <outlet property="versionLabel" destination="Version" id="c-0054" />
                    </connections>
                </viewController>
                <customObject id="LandingResponder" userLabel="First Responder" customClass="NSResponder" sceneMemberID="firstResponder" />
            </objects>
        </scene>
        <scene sceneID="HomeScene">
