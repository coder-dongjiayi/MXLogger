# The demo builds the native Apple API directly from this checkout.
require 'json'

sdk_path = IO.popen(['xcrun', '--sdk', 'macosx', '--show-sdk-path'], &:read).strip
sdk = JSON.parse(File.read(File.join(sdk_path, 'SDKSettings.json')))
sdk_minimum = sdk.fetch('SupportedTargets').fetch('macosx').fetch('MinimumDeploymentTarget')
demo_target = [Gem::Version.new('10.13'), Gem::Version.new(sdk_minimum)].max.to_s
File.write(File.join(__dir__, 'Configurations/SDK.xcconfig'),
           "// Generated by pod install for this Xcode SDK.\nMACOSX_DEPLOYMENT_TARGET = #{demo_target}\n")

platform :osx, demo_target
project 'MXLoggerDemo'
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

target 'MXLoggerDemo' do
  use_frameworks! :linkage => :static
  pod 'MXLogger', :path => '../../..'
  pod 'MXLoggerCore', :path => '../../..'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = demo_target
    end
  end
end
