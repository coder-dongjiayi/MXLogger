# Ignore development caches; windows/bin DLLs and manifest must ship in the package.
.DS_Store
.dart_tool/
.packages
.pub/
build/
/pubspec.lock
.idea/
**/*.iml
test/native/libmxlogger_test.dylib
test/native/build_tmp/
darwin/flutter_mxlogger/.build/
darwin/flutter_mxlogger/.swiftpm/
darwin/FlutterFramework/
# Native host build caches and signing/local configuration are never packaged.
**/.gradle/
**/.cxx/
**/Pods/
**/.symlinks/
**/ephemeral/
**/local.properties
**/key.properties
**/*.jks
**/*.keystore
**/.hvigor/
**/oh_modules/
**/node_modules/
**/oh-package-lock.json5
**/BuildProfile.ets
example/ohos/build-profile.json5
